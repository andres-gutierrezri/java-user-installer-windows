# Copie este archivo como ".env" para fijar valores por defecto del instalador.
# Los parámetros indicados en la línea de comandos tienen precedencia sobre este archivo.

# latest = última versión de características | lts = última LTS | número (p. ej. 21)
JAVA_VERSION=latest

# Carpeta raíz de instalación (se crea si no existe). Java quedará en <INSTALL_ROOT>\Java
INSTALL_ROOT=C:\Programs

# true/false: instalar la imagen JRE independiente además del JDK
INCLUDE_JRE=true

# true/false: crear el acceso directo "Configuración de Java" en el escritorio
CREATE_SHORTCUT=true
